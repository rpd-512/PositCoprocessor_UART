@file(best_operating_point.tcl) 213: set best_freq ""
@file(best_operating_point.tcl) 214: foreach f [lsort -integer -decreasing [array names RES]] {
    if {[passes [lindex $RES($f) 1]] && [info exists WRITE_OK($f)] && $WRITE_OK($f)} {
        set best_freq $f
        break
    }
}
@file(best_operating_point.tcl) 221: if {$best_freq eq ""} {
    puts "\nERROR: no point met timing with a saved netlist. No hand-off written."
    puts "Sweep CSV: $CSV_PATH"
    return
}
@file(best_operating_point.tcl) 227: lassign $RES($best_freq) b_area b_wns b_leak b_dyn b_tot
@file(best_operating_point.tcl) 228: set best_period [expr {1000.0 / $best_freq}]
@file(best_operating_point.tcl) 229: set pt_dir "$OUT_DIR/pt_${best_freq}MHz"
@file(best_operating_point.tcl) 231: file mkdir $HANDOFF_DIR
@file(best_operating_point.tcl) 232: file mkdir $HANDOFF_DIR/rtl_snapshot
@file(best_operating_point.tcl) 235: file copy -force $pt_dir/${TOP_MODULE}_netlist.v $HANDOFF_DIR/
@file(best_operating_point.tcl) 236: file copy -force $pt_dir/${TOP_MODULE}.sdc       $HANDOFF_DIR/
@file(best_operating_point.tcl) 237: if {[file exists $pt_dir/${TOP_MODULE}_setup.tcl]} {
    file copy -force $pt_dir/${TOP_MODULE}_setup.tcl $HANDOFF_DIR/
}
@file(best_operating_point.tcl) 240: foreach r {area power timing} {
    file copy -force $OUT_DIR/${r}_${best_freq}.rpt $HANDOFF_DIR/${r}.rpt
}
@file(best_operating_point.tcl) 243: file copy -force $CSV_PATH $HANDOFF_DIR/sweep_results.csv
@file(best_operating_point.tcl) 244: catch { file copy -force [info script] $HANDOFF_DIR/ }
@file(best_operating_point.tcl) 247: set snap_files {}
@file(best_operating_point.tcl) 248: foreach f $RTL_FILES {
    file copy -force $f $HANDOFF_DIR/rtl_snapshot/
    lappend snap_files [file normalize $HANDOFF_DIR/rtl_snapshot/[file tail $f]]
}
@file(best_operating_point.tcl) 254: proc md5_of ...
@file(best_operating_point.tcl) 258: proc try_get ...
@file(best_operating_point.tcl) 263: set lib_abs [file normalize $LIB_FILES]
@file(best_operating_point.tcl) 264: set net_abs [file normalize $HANDOFF_DIR/${TOP_MODULE}_netlist.v]
@file(best_operating_point.tcl) 265: set sdc_abs [file normalize $HANDOFF_DIR/${TOP_MODULE}.sdc]
@file(best_operating_point.tcl) 268: set mf [open $HANDOFF_DIR/MANIFEST.txt w]
@file(best_operating_point.tcl) 269: puts $mf "GENUS SWEEP HAND-OFF MANIFEST"
@file(best_operating_point.tcl) 270: puts $mf "============================="
@file(best_operating_point.tcl) 271: puts $mf "date            : [clock format [clock seconds]]"
@file(best_operating_point.tcl) 272: puts $mf "host / user     : [try_get {info hostname}] / [try_get {set ::env(USER)}]"
@file(best_operating_point.tcl) 273: puts $mf "run directory   : [pwd]"
@file(best_operating_point.tcl) 274: puts $mf "genus version   : [try_get {get_db program_version}]"
@file(best_operating_point.tcl) 275: puts $mf "top module      : $TOP_MODULE"
@file(best_operating_point.tcl) 276: puts $mf ""
@file(best_operating_point.tcl) 277: puts $mf "SELECTED POINT"
@file(best_operating_point.tcl) 278: puts $mf "  frequency          : $best_freq MHz  (period $best_period ns)"
@file(best_operating_point.tcl) 279: puts $mf "  WNS (setup)        : $b_wns ns   (from Genus report_timing, worst path reported)"
@file(best_operating_point.tcl) 280: puts $mf "  area               : $b_area um^2 (Genus report_area)"
@file(best_operating_point.tcl) 281: puts $mf "  leakage / dynamic / total power : $b_leak / $b_dyn / $b_tot uW"
@file(best_operating_point.tcl) 282: puts $mf "  selection rule     : highest frequency measured with WNS >= 0 in this run"
@file(best_operating_point.tcl) 283: puts $mf "  binary-search result (hi-lo <= $FREQ_TOL MHz) : $search_best MHz"
@file(best_operating_point.tcl) 284: if {!$ceiling_found} {
    puts $mf "  WARNING: no tested frequency failed; $search_best MHz is only a LOWER BOUND on max frequency (FREQ_HIGH=$FREQ_HIGH too low)"
}
@file(best_operating_point.tcl) 287: puts $mf ""
@file(best_operating_point.tcl) 288: puts $mf "CONSTRAINTS USED"
@file(best_operating_point.tcl) 289: puts $mf "  clock port 'clk', period = 1000/freq ns"
@file(best_operating_point.tcl) 290: puts $mf "  input delay  = $IO_DELAY_FRAC x period, output delay = $IO_DELAY_FRAC x period"
@file(best_operating_point.tcl) 291: puts $mf "  no uncertainty, no false/multicycle paths, no wire-load or parasitics"
@file(best_operating_point.tcl) 292: puts $mf ""
@file(best_operating_point.tcl) 293: puts $mf "TOOL SETTINGS (values as reported by Genus at run time; this script does not set them)"
@file(best_operating_point.tcl) 294: foreach a {syn_generic_effort syn_map_effort syn_opt_effort} {
    puts $mf "  $a = [try_get [list get_db $a]]"
}
@file(best_operating_point.tcl) 297: puts $mf ""
@file(best_operating_point.tcl) 298: puts $mf "INPUT CHECKSUMS (md5)"
@file(best_operating_point.tcl) 299: puts $mf "  [md5_of $lib_abs]  $lib_abs"
@file(best_operating_point.tcl) 300: foreach f $RTL_FILES { puts $mf "  [md5_of $f]  [file normalize $f]" }
@file(best_operating_point.tcl) 301: puts $mf "  RTL git commit : [try_get [list exec git -C $RTL_DIR rev-parse HEAD]]"
@file(best_operating_point.tcl) 302: set git_st [try_get [list exec git -C $RTL_DIR status --porcelain]]
@file(best_operating_point.tcl) 303: if {$git_st eq "unavailable"} { set git_dirty "unknown (git not available)" } \
elseif {$git_st eq ""}        { set git_dirty "no" } \
else                          { set git_dirty "yes (uncommitted changes in RTL dir)" }
@file(best_operating_point.tcl) 306: puts $mf "  RTL git dirty  : $git_dirty"
@file(best_operating_point.tcl) 307: puts $mf ""
@file(best_operating_point.tcl) 308: puts $mf "STATUS / LIMITATIONS"
@file(best_operating_point.tcl) 309: puts $mf "  * The selected netlist was written in the same Genus session that measured it,"
@file(best_operating_point.tcl) 310: puts $mf "    but that session ran several frequencies back-to-back on one elaboration."
@file(best_operating_point.tcl) 311: puts $mf "    Results can depend on that history. It has NOT been re-run from a fresh session"
@file(best_operating_point.tcl) 312: puts $mf "    unless ./handoff/verified/VERIFY_STATUS.txt exists and says so."
@file(best_operating_point.tcl) 313: puts $mf "  * Timing is synthesis-level (no placement/routing parasitics). Post-route slack in"
@file(best_operating_point.tcl) 314: puts $mf "    Innovus will generally be worse; a point at WNS ~ 0 has no margin."
@file(best_operating_point.tcl) 315: puts $mf "  * Only setup timing was checked. Hold is not evaluated here."
@file(best_operating_point.tcl) 316: puts $mf "  * Power is vectorless estimation and is not frequency-accurate."
@file(best_operating_point.tcl) 317: puts $mf "  * LEF/tech files, RC corners, and power-net names are NOT produced by Genus."
@file(best_operating_point.tcl) 318: puts $mf ""
@file(best_operating_point.tcl) 319: puts $mf "FILES"
@file(best_operating_point.tcl) 320: puts $mf "  ${TOP_MODULE}_netlist.v   mapped netlist for Innovus (init_verilog)"
@file(best_operating_point.tcl) 321: puts $mf "  ${TOP_MODULE}.sdc         constraints for Innovus"
@file(best_operating_point.tcl) 322: puts $mf "  area/power/timing.rpt    Genus reports for the selected point"
@file(best_operating_point.tcl) 323: puts $mf "  sweep_results.csv        every point measured (binary search + local sweep)"
@file(best_operating_point.tcl) 324: puts $mf "  rtl_snapshot/            exact RTL used, in synthesis order"
@file(best_operating_point.tcl) 325: puts $mf "  reproduce_at_best.tcl    fresh-session re-run + pass/fail check"
